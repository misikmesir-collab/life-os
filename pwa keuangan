
<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#101827">
<meta name="description" content="Catatan Uang — pengelola keuangan pribadi offline.">
<title>Catatan Uang</title>
<style>
:root{color-scheme:dark;--bg:#0b1220;--panel:#121d2e;--panel2:#18263a;--line:#26364d;--text:#edf3fb;--muted:#9aabc0;--green:#43d6a0;--red:#ff7185;--blue:#72a7ff;--yellow:#f5c86a}
*{box-sizing:border-box}
body{margin:0;background:linear-gradient(160deg,#101c30,#09111e 55%);color:var(--text);font:15px system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh}
header{position:sticky;top:0;z-index:5;background:#0d1727ed;backdrop-filter:blur(14px);border-bottom:1px solid var(--line);padding:15px max(16px,calc((100vw - 760px)/2));display:flex;align-items:center;justify-content:space-between}
.brand{font-weight:800;letter-spacing:.2px}.brand small{display:block;color:var(--muted);font-weight:500;font-size:11px}
main{max-width:760px;margin:auto;padding:16px 14px 100px}.page{display:none}.page.active{display:block}
h2{font-size:19px;margin:18px 0 12px}h3{font-size:15px;margin:0 0 10px}
.card{background:linear-gradient(145deg,var(--panel),#101a2a);border:1px solid var(--line);border-radius:18px;padding:16px;margin:12px 0;box-shadow:0 8px 25px #0002}
.hero{background:linear-gradient(130deg,#193e49,#182e4d 60%,#202c4b);border:1px solid #31516a}
.muted{color:var(--muted);font-size:12px}.amount{font-size:29px;font-weight:800;letter-spacing:-.7px;margin:5px 0}.positive{color:var(--green)}.negative{color:var(--red)}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.stat{background:#ffffff08;border:1px solid #ffffff12;border-radius:14px;padding:12px}.stat strong{display:block;font-size:18px;margin-top:4px}
button,input,select,textarea{font:inherit}button{border:0;border-radius:12px;padding:11px 14px;background:var(--blue);color:#081323;font-weight:700;cursor:pointer}
button.secondary{background:var(--panel2);color:var(--text);border:1px solid var(--line)}button.danger{background:#4a2430;color:#ffdce2}button.small{padding:7px 10px;font-size:12px}
.actions{display:flex;gap:8px;flex-wrap:wrap}.row{display:flex;align-items:center;justify-content:space-between;gap:12px}
form{display:grid;gap:10px}label{display:grid;gap:5px;color:var(--muted);font-size:12px}
input,select,textarea{width:100%;background:#0b1524;border:1px solid var(--line);color:var(--text);padding:12px;border-radius:11px;outline:none}input:focus,select:focus{border-color:var(--blue)}
.list{display:grid;gap:8px}.item{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 0;border-bottom:1px solid var(--line)}.item:last-child{border:0}.item b{display:block;font-size:14px}.pill{font-size:11px;padding:4px 8px;border-radius:99px;background:#ffffff12;color:var(--muted)}
nav{position:fixed;bottom:0;left:0;right:0;z-index:8;background:#0d1727f2;border-top:1px solid var(--line);display:flex;justify-content:center;padding:8px 6px calc(8px + env(safe-area-inset-bottom));backdrop-filter:blur(14px)}
nav button{background:transparent;color:var(--muted);padding:8px 12px;flex:1;max-width:130px;font-size:11px}nav button.active{color:var(--green);background:#43d6a018}
nav span{display:block;font-size:19px;margin-bottom:2px}
.progress{height:8px;background:#ffffff14;border-radius:99px;overflow:hidden;margin:9px 0}.progress i{display:block;height:100%;background:var(--green);border-radius:99px}
.empty{text-align:center;color:var(--muted);padding:20px 8px;font-size:13px}
hr{border:0;border-top:1px solid var(--line);margin:14px 0}
.note{background:#18283a;border-left:3px solid var(--yellow);padding:11px;border-radius:8px;color:#d6e0ed;font-size:12px}
@media(min-width:600px){main{padding-top:24px}.grid.three{grid-template-columns:repeat(3,1fr)}}
</style>
</head>
<body>
<header>
<div class="brand">◈ Catatan Uang <small>Personal Finance Manager · Offline</small></div>
<button class="secondary small" id="privacyBtn">Sembunyikan saldo</button>
</header>
<main>
<section id="home" class="page active">
<div class="card hero">
<div class="muted">Total saldo seluruh dompet</div>
<div class="amount" id="totalBalance">Rp0</div>
<div class="muted" id="todayLabel"></div>
<hr>
<div class="grid">
<div><div class="muted">Pemasukan bulan ini</div><b class="positive" id="monthIn">Rp0</b></div>
<div><div class="muted">Pengeluaran bulan ini</div><b class="negative" id="monthOut">Rp0</b></div>
</div>
</div>
<div class="grid">
<div class="stat"><span class="muted">Arus kas bulan ini</span><strong id="cashflow">Rp0</strong></div>
<div class="stat"><span class="muted">Jumlah transaksi</span><strong id="txCount">0</strong></div>
</div>
<h2>Dompet</h2><div class="card list" id="walletSummary"></div>
<div class="row"><h2>Transaksi terbaru</h2><button class="small" onclick="showPage('transactions')">Lihat semua</button></div>
<div class="card list" id="recentTx"></div>
</section>

<section id="transactions" class="page">
<h2>Tambah transaksi</h2>
<div class="card">
<form id="txForm">
<div class="grid">
<label>Jenis<select id="txType"><option value="expense">Pengeluaran</option><option value="income">Pemasukan</option><option value="transfer">Transfer</option></select></label>
<label>Nominal (Rp)<input id="txAmount" type="number" min="1" step="1" required placeholder="25000"></label>
</div>
<label>Keterangan<input id="txNote" maxlength="90" required placeholder="Contoh: makan siang"></label>
<div class="grid" id="walletFields">
<label>Dompet<select id="txWallet"></select></label>
<label>Kategori<select id="txCategory"></select></label>
</div>
<div class="grid" id="transferFields" hidden>
<label>Dari dompet<select id="fromWallet"></select></label>
<label>Ke dompet<select id="toWallet"></select></label>
</div>
<label>Tanggal<input id="txDate" type="date" required></label>
<button type="submit">Simpan transaksi</button>
</form>
</div>
<h2>Riwayat transaksi</h2>
<div class="card"><input id="searchTx" placeholder="Cari keterangan atau kategori..."><div class="list" id="txList"></div></div>
</section>

<section id="plans" class="page">
<h2>Anggaran bulanan</h2>
<div class="card">
<form id="budgetForm">
<label>Kategori<select id="budgetCategory"></select></label>
<label>Batas anggaran (Rp)<input id="budgetAmount" type="number" min="1" required placeholder="400000"></label>
<button>Simpan anggaran</button>
</form>
</div>
<div id="budgetList"></div>
<h2>Target tabungan</h2>
<div class="card">
<form id="goalForm">
<label>Nama tujuan<input id="goalName" required placeholder="Dana darurat"></label>
<label>Target (Rp)<input id="goalTarget" type="number" min="1" required></label>
<label>Saldo terkumpul saat ini (Rp)<input id="goalSaved" type="number" min="0" value="0"></label>
<button>Tambah target</button>
</form>
</div>
<div id="goalList"></div>
</section>

<section id="reports" class="page">
<h2>Laporan bulan ini</h2>
<div class="grid">
<div class="stat"><span class="muted">Pemasukan</span><strong class="positive" id="repIn">Rp0</strong></div>
<div class="stat"><span class="muted">Pengeluaran</span><strong class="negative" id="repOut">Rp0</strong></div>
</div>
<div class="card"><h3>Pengeluaran per kategori</h3><div id="categoryReport"></div></div>
<div class="card">
<h3>Ringkasan posisi keuangan</h3>
<div class="row"><span class="muted">Saldo dompet</span><b id="repBalance">Rp0</b></div>
<div class="row"><span class="muted">Total target tabungan</span><b id="repGoals">Rp0</b></div>
<div class="note" style="margin-top:12px">Tabungan adalah alokasi dari saldo, bukan uang tambahan. Jangan menjumlahkan target tabungan sekali lagi ke total aset apabila uangnya sudah berada di salah satu dompet.</div>
</div>
</section>

<section id="more" class="page">
<h2>Dompet & pengaturan</h2>
<div class="card">
<h3>Tambah dompet</h3>
<form id="walletForm">
<label>Nama dompet<input id="walletName" required placeholder="Tunai / Bank / E-wallet"></label>
<label>Saldo awal (Rp)<input id="walletOpening" type="number" min="0" value="0"></label>
<button>Tambah dompet</button>
</form>
<div id="walletList" class="list"></div>
</div>
<div class="card">
<h3>Backup & pemulihan</h3>
<p class="muted">Simpan salinan data sebagai file JSON. Simpan file backup di tempat aman.</p>
<div class="actions">
<button id="exportBtn">Ekspor backup</button>
<label class="secondary" style="display:inline-flex;padding:10px 12px;border-radius:12px;color:var(--text)">Pulihkan JSON<input id="importFile" type="file" accept="application/json" hidden></label>
</div>
</div>
<div class="card">
<h3>Privasi dan penyimpanan</h3>
<p class="muted">Data disimpan di perangkat ini. Menghapus data browser atau mengganti perangkat dapat menghilangkan catatan jika belum membuat backup.</p>
<button class="danger" id="resetBtn">Hapus seluruh data</button>
</div>
<div class="note">Versi awal ini bekerja lokal. Sinkronisasi cloud, enkripsi menyeluruh, notifikasi terjadwal, dan AI belum disertakan.</div>
</section>
</main>

<nav>
<button class="active" data-page="home"><span>⌂</span>Beranda</button>
<button data-page="transactions"><span>↕</span>Transaksi</button>
<button data-page="plans"><span>◎</span>Rencana</button>
<button data-page="reports"><span>▥</span>Laporan</button>
<button data-page="more"><span>☷</span>Lainnya</button>
</nav>

<script>
const KEY='catatanUangPWA_v1';
const defaults={wallets:[{id:'w_cash',name:'Tunai',opening:0},{id:'w_bank',name:'Rekening',opening:0}],transactions:[],budgets:[],goals:[]};
let db=load(),hidden=false;

function load(){
try{return {...structuredClone(defaults),...JSON.parse(localStorage.getItem(KEY)||'{}')}}
catch{return structuredClone(defaults)}
}
function save(){localStorage.setItem(KEY,JSON.stringify(db));render()}
const rupiah=n=>'Rp'+Math.round(Number(n)||0).toLocaleString('id-ID');
const today=()=>new Date().toISOString().slice(0,10);
const month=()=>today().slice(0,7);

function walletBalance(id){
const w=db.wallets.find(x=>x.id===id);
if(!w)return 0;
return Number(w.opening||0)+db.transactions.reduce((s,t)=>{
if(t.type==='income'&&t.wallet===id)return s+t.amount;
if(t.type==='expense'&&t.wallet===id)return s-t.amount;
if(t.type==='transfer'){
if(t.from===id)s-=t.amount;
if(t.to===id)s+=t.amount;
}
return s;
},0)
}

function totals(){
const ts=db.transactions.filter(t=>t.date.startsWith(month()));
return {
inc:ts.filter(t=>t.type==='income').reduce((s,t)=>s+t.amount,0),
out:ts.filter(t=>t.type==='expense').reduce((s,t)=>s+t.amount,0)
}
}

function esc(s){
return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))
}

function fillSelects(){
const opts=db.wallets.map(w=>`<option value="${w.id}">${esc(w.name)}</option>`).join('');
['txWallet','fromWallet','toWallet'].forEach(id=>document.getElementById(id).innerHTML=opts);
const cats=['Makanan','Transportasi','Pendidikan','Kebutuhan pribadi','Hiburan','Tagihan','Kesehatan','Lainnya'];
['txCategory','budgetCategory'].forEach(id=>document.getElementById(id).innerHTML=cats.map(c=>`<option>${c}</option>`).join(''))
}

function showPage(id){
document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===id));
document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===id));
render()
}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>showPage(b.dataset.page));

document.getElementById('txType').onchange=e=>{
const tr=e.target.value==='transfer';
document.getElementById('walletFields').hidden=tr;
document.getElementById('transferFields').hidden=!tr;
document.getElementById('txCategory').required=!tr
};

document.getElementById('txDate').value=today();

document.getElementById('txForm').onsubmit=e=>{
e.preventDefault();
const type=txType.value,amount=Number(txAmount.value),date=txDate.value,note=txNote.value.trim();
if(!amount||amount<=0)return alert('Nominal harus lebih dari nol.');
let t={id:crypto.randomUUID(),type,amount,date,note,createdAt:new Date().toISOString()};
if(type==='transfer'){
if(fromWallet.value===toWallet.value)return alert('Dompet asal dan tujuan harus berbeda.');
if(walletBalance(fromWallet.value)<amount)return alert('Saldo dompet asal tidak mencukupi.');
t.from=fromWallet.value;t.to=toWallet.value;t.category='Transfer'
}else{
t.wallet=txWallet.value;t.category=txCategory.value;
if(type==='expense'&&walletBalance(t.wallet)<amount&&!confirm('Saldo dompet akan menjadi negatif. Tetap simpan?'))return
}
db.transactions.unshift(t);
e.target.reset();
txDate.value=today();
save()
};

document.getElementById('searchTx').oninput=renderTransactions;

document.getElementById('budgetForm').onsubmit=e=>{
e.preventDefault();
const category=budgetCategory.value,amount=Number(budgetAmount.value);
if(amount<=0)return;
db.budgets=db.budgets.filter(b=>!(b.category===category&&b.month===month()));
db.budgets.push({id:crypto.randomUUID(),category,amount,month:month()});
e.target.reset();save()
};

document.getElementById('goalForm').onsubmit=e=>{
e.preventDefault();
db.goals.push({id:crypto.randomUUID(),name:goalName.value.trim(),target:Number(goalTarget.value),saved:Number(goalSaved.value)||0});
e.target.reset();save()
};

document.getElementById('walletForm').onsubmit=e=>{
e.preventDefault();
db.wallets.push({id:crypto.randomUUID(),name:walletName.value.trim(),opening:Number(walletOpening.value)||0});
e.target.reset();save()
};

document.getElementById('exportBtn').onclick=()=>{
const blob=new Blob([JSON.stringify({schemaVersion:1,...db},null,2)],{type:'application/json'});
const a=document.createElement('a');
a.href=URL.createObjectURL(blob);
a.download='catatan-uang-backup-'+today()+'.json';
a.click();
URL.revokeObjectURL(a.href)
};

document.getElementById('importFile').onchange=async e=>{
const f=e.target.files[0];if(!f)return;
try{
const x=JSON.parse(await f.text());
if(!Array.isArray(x.wallets)||!Array.isArray(x.transactions))throw Error();
if(confirm('Pulihkan backup? Data saat ini akan diganti. Sebaiknya ekspor backup terlebih dahulu.')){
db={...structuredClone(defaults),...x};save();alert('Backup berhasil dipulihkan.')
}
}catch{alert('File backup tidak valid.')}
e.target.value=''
};

document.getElementById('resetBtn').onclick=()=>{
if(confirm('Hapus semua transaksi, dompet, anggaran, dan target? Tindakan ini tidak dapat dibatalkan.')){
db=structuredClone(defaults);save()
}
};

document.getElementById('privacyBtn').onclick=()=>{
hidden=!hidden;
privacyBtn.textContent=hidden?'Tampilkan saldo':'Sembunyikan saldo';
render()
};

function money(n){return hidden?'••••••':rupiah(n)}

function renderTransactions(){
const q=(searchTx.value||'').toLowerCase();
const list=db.transactions.filter(t=>(t.note+' '+(t.category||'')).toLowerCase().includes(q));
txList.innerHTML=list.length?list.map(t=>{
const label=t.type==='transfer'?'Transfer':t.type==='income'?'Pemasukan':'Pengeluaran';
const w=t.type==='transfer'?`${db.wallets.find(x=>x.id===t.from)?.name||'?'} → ${db.wallets.find(x=>x.id===t.to)?.name||'?'}`:db.wallets.find(x=>x.id===t.wallet)?.name||'Dompet dihapus';
return `<div class="item"><div><b>${esc(t.note)} <span class="pill">${label}</span></b><div class="muted">${esc(t.category||'')} · ${t.date} · ${esc(w)}</div></div><div style="text-align:right"><b class="${t.type==='income'?'positive':t.type==='expense'?'negative':''}">${t.type==='income'?'+':t.type==='expense'?'-':''}${money(t.amount)}</b><button class="small danger" onclick="deleteTx('${t.id}')">Hapus</button></div></div>`
}).join(''):'<div class="empty">Belum ada transaksi.</div>'
}

function deleteTx(id){
if(confirm('Hapus transaksi ini?')){
db.transactions=db.transactions.filter(t=>t.id!==id);save()
}
}

function render(){
fillSelects();
const t=totals(),balance=db.wallets.reduce((s,w)=>s+walletBalance(w.id),0);
totalBalance.textContent=money(balance);
monthIn.textContent=money(t.inc);
monthOut.textContent=money(t.out);
cashflow.textContent=money(t.inc-t.out);
txCount.textContent=db.transactions.filter(x=>x.date.startsWith(month())).length;
todayLabel.textContent=new Date().toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
walletSummary.innerHTML=db.wallets.map(w=>`<div class="row"><span>${esc(w.name)}</span><b>${money(walletBalance(w.id))}</b></div>`).join('')||'<div class="empty">Belum ada dompet.</div>';
recentTx.innerHTML=db.transactions.slice(0,5).map(x=>`<div class="row"><span>${esc(x.note)}<small class="muted" style="display:block">${x.date}</small></span><b class="${x.type==='income'?'positive':x.type==='expense'?'negative':''}">${x.type==='income'?'+':x.type==='expense'?'-':''}${money(x.amount)}</b></div>`).join('')||'<div class="empty">Catat transaksi pertamamu.</div>';
renderTransactions();
renderPlans();
renderReports();
walletList.innerHTML=db.wallets.map(w=>`<div class="item"><span>${esc(w.name)}<small class="muted" style="display:block">Saldo awal ${rupiah(w.opening)}</small></span><b>${money(walletBalance(w.id))}</b></div>`).join('')
}

function renderPlans(){
const ts=db.transactions.filter(t=>t.date.startsWith(month())&&t.type==='expense');
budgetList.innerHTML=db.budgets.filter(b=>b.month===month()).map(b=>{
const used=ts.filter(t=>t.category===b.category).reduce((s,t)=>s+t.amount,0),pct=Math.min(100,used/b.amount*100);
return `<div class="card"><div class="row"><b>${esc(b.category)}</b><span class="muted">${Math.round(pct)}%</span></div><div class="progress"><i style="width:${pct}%"></i></div><div class="row muted"><span>${rupiah(used)} terpakai</span><span>dari ${rupiah(b.amount)}</span></div></div>`
}).join('')||'<div class="empty">Belum ada anggaran bulan ini.</div>';

goalList.innerHTML=db.goals.map(g=>{
const pct=Math.min(100,g.saved/g.target*100);
return `<div class="card"><div class="row"><b>${esc(g.name)}</b><span class="muted">${Math.round(pct)}%</span></div><div class="progress"><i style="width:${pct}%"></i></div><div class="row muted"><span>${rupiah(g.saved)}</span><span>Target ${rupiah(g.target)}</span></div><div class="actions" style="margin-top:10px"><button class="small secondary" onclick="addGoal('${g.id}')">Tambah setoran</button><button class="small danger" onclick="deleteGoal('${g.id}')">Hapus</button></div></div>`
}).join('')||'<div class="empty">Belum ada target tabungan.</div>'
}

function addGoal(id){
const g=db.goals.find(x=>x.id===id),n=Number(prompt('Nominal setoran (Rp):'));
if(n>0){g.saved+=n;save()}
}

function deleteGoal(id){
if(confirm('Hapus target ini?')){
db.goals=db.goals.filter(g=>g.id!==id);save()
}
}

function renderReports(){
repIn.textContent=money(totals().inc);
repOut.textContent=money(totals().out);
repBalance.textContent=money(db.wallets.reduce((s,w)=>s+walletBalance(w.id),0));
repGoals.textContent=money(db.goals.reduce((s,g)=>s+g.saved,0));
const cats={};
db.transactions.filter(t=>t.type==='expense'&&t.date.startsWith(month())).forEach(t=>cats[t.category]=(cats[t.category]||0)+t.amount);
const entries=Object.entries(cats).sort((a,b)=>b[1]-a[1]);
categoryReport.innerHTML=entries.map(([c,v])=>`<div class="item"><span>${esc(c)}</span><b>${money(v)}</b></div>`).join('')||'<div class="empty">Belum ada pengeluaran bulan ini.</div>'
}

render();
</script>
</body>
</html>
